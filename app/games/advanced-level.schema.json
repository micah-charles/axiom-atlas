{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-atlas.local/schemas/advanced-level.json",
  "title": "Axiom Atlas Advanced Level",
  "type": "object",
  "required": ["id", "world", "concept", "engine", "act", "objective", "tools", "goal", "revealNotationAfterCompletion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "world": { "type": "string", "minLength": 1 },
    "concept": { "type": "string", "minLength": 1 },
    "engine": { "enum": ["curve", "field", "flow", "dynamic", "transformation", "plane", "signal", "graph", "probability", "geometry"] },
    "act": { "enum": ["experience", "control", "measure", "generalise", "name"] },
    "objective": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "goal": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "minLength": 1 }, "target": { "type": "number" }, "moveLimit": { "type": "number" } }, "additionalProperties": false },
    "revealNotationAfterCompletion": { "const": true },
    "seed": { "type": "integer" },
    "dailyKey": { "type": "string" }
  },
  "additionalProperties": false
}
